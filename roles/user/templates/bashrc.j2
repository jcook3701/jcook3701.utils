{%- macro bashrc() -%}
# Force high-visibility color prompts on the system terminal
export TERM=xterm-256color
PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '

# Strict management constraints for command line memory histories
export HISTSIZE=5000
export HISTFILESIZE=10000
export HISTCONTROL=ignoreboth:erasedups
shopt -s histappend

# Global shorthand aliases for rapid navigation passes
alias ll='ls -laF'
alias grep='grep --color=auto'
{%- endmacro -%}

{{- bashrc() }}
