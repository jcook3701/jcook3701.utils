{%- macro redhat_repo() -%}
[{{ repo_add_id }}]
name={{ repo_add_name }}
baseurl={{ repo_add_redhat_baseurl }}
enabled={{ 1 if repo_add_enabled else 0 }}
gpgcheck={{ 1 if repo_add_redhat_gpgcheck else 0 }}
